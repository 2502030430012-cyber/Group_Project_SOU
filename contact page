<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .contact-container {
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-wrap: wrap;
            max-width: 1000px;
            width: 100%;
            overflow: hidden;
        }

        /* Left Side: Contact Info */
        .contact-info {
            background-color: #1a252f;
            color: #ffffff;
            flex: 1 1 400px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .contact-info h2 {
            font-size: 2rem;
            margin-bottom: 20px;
            color: #3498db;
        }

        .contact-info p {
            color: #bdc3c7;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .info-details {
            margin-bottom: 40px;
        }

        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .info-item .icon {
            font-size: 1.5rem;
            margin-right: 15px;
            color: #3498db;
        }

        .info-item a {
            color: #ffffff;
            text-decoration: none;
        }

        .info-item a:hover {
            text-decoration: underline;
        }

        /* Right Side: Contact Form */
        .contact-form-wrapper {
            flex: 1 1 500px;
            padding: 40px;
        }

        .contact-form-wrapper h3 {
            font-size: 1.8rem;
            margin-bottom: 20px;
            color: #2c3e50;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #7f8c8d;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #dcdde1;
            border-radius: 5px;
            font-size: 1rem;
            color: #2c3e50;
            outline: none;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #3498db;
        }

        .form-group textarea {
            resize: vertical;
            height: 150px;
        }

        .submit-btn {
            background-color: #3498db;
            color: #ffffff;
            border: none;
            padding: 14px 28px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.3s ease;
        }

        .submit-btn:hover {
            background-color: #2980b9;
        }

        /* Responsive Breakpoints */
        @media (max-width: 768px) {
            .contact-container {
                flex-direction: column;
            }
            .contact-info, .contact-form-wrapper {
                padding: 30px;
            }
        }
    </style>
</head>
<body>

    <div class="contact-container">
        <!-- Left Side: Contact Information -->
        <div class="contact-info">
            <div>
                <h2>Get in Touch</h2>
                <p>Feel free to contact us any time. We will get back to you as soon as we can!</p>
                
                <div class="info-details">
                    <div class="info-item">
                        <span class="icon">📍</span>
                        <address style="font-style: normal;">123 Business Rd, Suite 100, Metropolis</address>
                    </div>
                    <div class="info-item">
                        <span class="icon">📞</span>
                        <a href="tel:+1234567890">+1 (234) 567-890</a>
                    </div>
                    <div class="info-item">
                        <span class="icon">✉️</span>
                        <a href="mailto:info@yourdomain.com">info@yourdomain.com</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Contact Form -->
        <div class="contact-form-wrapper">
            <h3>Send a Message</h3>
            
            <!-- Replace 'your@email.com' with your real email address -->
            <form action="https://formsubmit.co/your@email.com" method="POST">
                
                <!-- Anti-Spam Honeypot Field -->
                <input type="text" name="_honey" style="display:none">
                
                <!-- Custom Thank You Redirect Page (Optional) -->
                <!-- <input type="hidden" name="_next" value="https://yourdomain.com"> -->

                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="John Doe" required>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="john@example.com" required>
                </div>

                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" placeholder="How can we help?" required>
                </div>

                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Type your message here..." required></textarea>
                </div>

                <button type="submit" class="submit-btn">Send Message</button>
            </form>
        </div>
    </div>

</body>
</html>
